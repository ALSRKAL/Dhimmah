# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Editor and tooling state that belongs to a machine, not to the project.
# `.mimosa` is a scanner's history and `.zcodeignore` mirrors this file for one
# editor's file listing; neither is part of the app.
.zcodeignore
.mimosa/

# Agent session state (plans, transcripts) — machine-local.
.zcode/

# Raw evidence and mission logs stay on the machine: screenshots, hierarchy
# dumps and test logs run to hundreds of megabytes. The reports that cite them
# are tracked, under docs/.
/artifacts/
docs/final-acceptance/

# Signing material must never enter history: the upload key and its passwords
# are the release's identity. Play App Signing keeps the app restorable if the
# upload key is lost, but a leaked key is permanent.
android/key.properties
*.jks
*.keystore
# The upload key and the file holding its password live outside version
# control. `*.jks` already covers the key; this covers everything next to it,
# including the plain-text password file, which no pattern above matched.
Dhimmah-release-keys/